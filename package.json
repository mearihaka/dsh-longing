{
  "name": "dsh-longing",
  "version": "1.0.0",
  "description": "Longing (暗涌): a drifting desire state (lust/lewd/possess/shame/resist/fatigue/affection) with a local panel and a first-person prompt block for DeepSeek Harness.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "persona",
    "desire"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    }
  },
  "files": [
    "src",
    "panel",
    "docs",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
